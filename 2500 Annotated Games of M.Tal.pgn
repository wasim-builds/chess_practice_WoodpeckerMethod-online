5 Ba8 $1 $17 {[%cal Gc6e5] Myers})) (25. Qxe4 $5 {Myers Huebner Mednis} e5 $1 26. Bf3 Ba8 $1 (26... f5 27. Qh4 $15) 27. Qg4+ Kh8 28. Bxc6 (28. Qh4 Nd4 $17) 28... Bxc6 29. Qe6 f5 $17 {[%cal Gf5f4,Yc6e4] Myers}) 25... Ne5 26. Ng3 (26. Bd3 $5 {Myers Huebner Mednis}) 26... Ng6 $2 {?! Myers Huebner Mednis: '?!' Myers Huebner Mednis: 'Mednis: Huebner considers this inaccurate since the Knight stood quite well and removing it to here only serves to chase the White Queen toward the Queenside, where White's real attacking chances lie.'} (26... Kh8 $15 {/ Myers Huebner Mednis: '' Myers Huebner Mednis: 'Huebner'}) (26... Rd7 {Myers Huebner Mednis} 27. Nh5+) 27. Qd4 Kh8 (27... Ne5 $142 $17 {[%cal Gg7h8] Myers Huebner Mednis Myers}) 28. Nh5 {Myers Huebner Mednis: '?' Myers Huebner Mednis: 'This routine attacking move in fact loses the game.'} (28. Qb6 {%03'better is' Myers Huebner Mednis: '!'} Rd7 29. a4 (29. c4 {!?}) (29. Bf3 {Myers Huebner Mednis} Bc8 $1 30. Ne4 d5 31. Nd6 Ne5 32. Nxc8 Rxc8 33. Qxe6 $132 {Myers}) 29... bxa4 30. Bxa6 $13 {Tal}) 28... Ne5 {Myers Huebner Mednis: '!'} (28... e5 {Myers Huebner Mednis: '?'} 29. Qb6 Rd7 30. c4 bxc4 31. Bxc4 d5 32. Bxa6 Bxa6 33. Qxa6 d4 34. Qc6 Re7 35. Qd6 $16 {Myers Huebner Mednis: ''}) (28... Rd7 $2 {Myers Huebner Mednis} 29. Bg4 e5 30. Qd3 Rdd8 31. Bf5 $40 {Myers}) 29. Qh4 $2 {? Myers Huebner Mednis: '?!'} (29. Qb6 {Myers Huebner Mednis: ''} Rd7 30. a4 $13 {Hubner} (30. Qe3 $5 {Myers Huebner Mednis}) 30... bxa4 {Myers Huebner Mednis} 31. Bxa6 Bc6 32. Nf4 $17 {Myers}) (29. Qe3 $142 $17 {[%cal Ge3h6] Myers Huebner Mednis Myers}) (29. Nf4 $142 {Myers Huebner Mednis} Rg8 30. g3 Bc8 31. a4 $15 {Mednis}) 29... Rd7 {! Myers Huebner Mednis: '!'} (29... Ng6 {?}) (29... Rc8 $5 {Myers Huebner Mednis}) 30. Nxf6 $6 {? Myers Huebner Mednis: '?' '?'} (30. a4 {'' Myers Huebner Mednis: '!?' '' Myers Huebner Mednis: 'Mednis'} Bc6 $15 {Myers Huebner Mednis}) (30. Qd4 $17) (30. Nf4 $142 $17 {Myers Huebner Mednis Myers} Re7 {Myers Huebner Mednis} 31. Qh3 (31. Qf2 $5) 31... Bc8 32. Qh6 Rg7 33. Nh5 Rgf7 34. c3 {[%cal Gh6d2,Yh5f4]} d5 $1 $15) 30... Rg7 $19 {Myers Huebner Mednis: '-+!'} 31. Qh6 (31. Ng4 Bxg2 {!} (31... Nxg4 32. Bxg4 Bxg2 {!}) 32. Kxg2 (32. h3 Bxh3) 32... Nxg4 33. Bxg4 Rxg4+ {'-+' Tal} 34. Qxg4 Rg8 {Myers Huebner Mednis: '-+'}) (31. g3 Rgf7 32. Ne4 Rf1+ {'-+' !} 33. Kg2 R1f2+ (33... R8f2+ {Myers Huebner Mednis} 34. Kh3 Rxe2 35. Qd8+ Kg7 36. Qc7+ Kg6 37. Qxb7 Nf3 $19) 34. Kh3 {Myers Huebner Mednis} Rxe2 $19) (31. g4 Bf3 {'-+'} 32. Kf1 {Myers Huebner Mednis} Ng6 33. Qg5 Rgf7 34. Nxh7 Bxe2+ 35. Kxe2 Kxh7 $19) 31... Rxg2+ 32. Kf1 Rf7 33. Bh5 Ng4 34. Bxg4 Rxg4 0-1

