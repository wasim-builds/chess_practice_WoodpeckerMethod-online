1. e4 e5 2. Nf3 Nc6 3. Bb5 a6 4. Ba4 Nf6 5. O-O Be7 6. Re1 b5 7. Bb3 d6 8. c3 O-O 9. d3 Na5 10. Bc2 c5 11. Nbd2 Re8 12. h3 Bf8 13. Nf1 Bb7 14. Ng3 g6 (14... h6 15. Nh2 d5 16. Ng4 Re6 17. Nf5) (14... Qc7 15. Bg5 Nd7 16. Bd2 d5 17. b4 cxb4 18. cxb4 Nc6 19. a3 Nb6 20. Bb3) (14... d5 15. exd5 Qxd5 16. Bg5 Qc6 (16... Nd7 17. Qe2 h6 18. Bd2 Qd6 19. Ne4 Qc7 20. Nh4 Re6 21. Rac1 Qd8 22. Nf5 Nf6) 17. a4 (17. Nf5 h6 18. Bd2 e4) 17... h6 18. axb5 axb5 19. Bd2 c4) 15. Bg5 (15. a3 Bg7 16. Bg5 h6 17. Be3 Nc6 18. Qd2 Kh7 19. Rad1) (15. d4 Bg7) 15... h6 16. Bd2 d5 17. exd5 $146 {18.bxc5 bxc5 19.xc5+ +-} c4 $2 (17... Qxd5 18. c4 Qd8 (18... bxc4 19. Bxa5 cxd3 20. Bxd3 e4 21. Bc3) 19. Nxe5) 18. b4 (18. Nxe5 Qxd5) 18... cxd3 (18... cxb3 19. axb3 Bxd5 20. c4 Bxf3 21. Qxf3 b4 22. Rxa5 Qxa5 23. Qxf6) 19. Bxd3 $18 Qxd5 (19... Nc4 20. Bxc4 bxc4 21. Nxe5 Qxd5 22. Nf3) 20. Be4 Nxe4 (20... Qc4 21. Qb1 Nc6 22. Bxg6 fxg6 23. Qxg6+ Bg7 24. Nf5) 21. Nxe4 Bg7 (21... Be7 $18 22. bxa5 f5 23. c4 bxc4 24. Nc3) (21... Re6 22. bxa5 f5 23. Ng3 e4 24. Nd4 e3 25. f3) 22. bxa5 f5 23. Ng3 (23. c4 bxc4 (23... Qd8 24. Nc5 Bxf3 25. gxf3) 24. Nc3 $18 Qc6 (24... Qxa5) (24... Qf7 25. Be3 Rad8 26. Qc1 e4 27. Nh2 Rd3)) 23... e4 24. Nh4 (24. Nh2 e3) 24... Bf6 (24... Rad8 {0,5/Adorjan,A-Ivkov,B/Skopje/1976/} 25. Be3 (25. Re2 Bxc3 26. Nxg6 $44 Bxd2 $5) (25. Bxh6 $1 Bxh6 26. Nxg6 f4) 25... Qf7 26. Qc1 Rd3 27. Bxh6 (27. Ne2 g5)) (24... Kh7 $14 25. Nxg6 Kxg6 26. Qh5+ Kh7 27. Bxh6 Bxh6 $16 28. Nxf5 Qe6 29. Rad1) 25. Nxg6 e3 26. Nf4 Qxd2 27. Rxe3 Qxd1+ 28. Rxd1 Rxe3 29. fxe3 $10 Rd8 (29... Bxc3 30. Nxf5 Bxa5 31. Rd7 Be4 32. Nxh6+) 30. Rxd8+ Bxd8 31. Nxf5 Bxa5 32. Nd5 (32. Nxh6+ Kh7 33. Nf5 Bxc3 $14) (32. Ne7+ Kf7 33. Ned5) 32... Kf8 $14 (32... Bxd5 33. Ne7+ Kf7 34. Nxd5 Ke6 35. Nb4 Bxb4 36. cxb4 Kd5 37. Kf2 Kc4 $14 38. a3 $4 Kb3 $18 39. e4 $5) 33. e4 Bxd5 34. exd5 h5 35. Kf2 Bxc3 $44 36. Ke3 Kf7 37. Kd3 Bb2 38. g4 hxg4 39. hxg4 Kf6 40. d6 Ke6 41. g5 a5 $16 (41... Kxf5 $2 42. d7) 42. g6 Bf6 $1 43. g7 Kf7 44. d7 (44. d7 Bd8 (44... a4 45. Nd6+ Kg8 (45... Kxg7 46. Ne8+ $13) 46. Nxb5 Kxg7 47. Na7 Kf7 48. Nc6 $13 Ke6 49. d8=Q $1 Bxd8 50. Nxd8+ $16) 45. Nd6+ Kxg7 46. Nb7 { 18.axb6 cxb6?} Bf6 $4 47. d8=Q $18 Bxd8 48. Nxd8) 1-0

[Event "Candidates Tournament"]
[Site "Bled/Zagreb/Belgrade"]
[Date "1959.10.11"]
[Round "20"]
[White "Tal, Mihail"]
[Black "Fischer, Robert James"]
[Result "1-0"]
[ECO "B33"]
[Annotator "Schandorff,Lars"]
[PlyCount "80"]
[EventDate "1959.09.07"]
[EventType "tourn"]
[EventRounds "28"]
[EventCountry "CRO"]
[SourceTitle "CBM 211"]
[Source "ChessBase"]
[SourceDate "2022.12.31"]
[SourceVersion "1"]
