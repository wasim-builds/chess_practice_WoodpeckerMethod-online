1. d4 {Polugaevsky,Lev Polugaevsky,Lev Ftacnik Polugaevsky,Lev} Nf6 2. Nf3 g6 3. c3 Bg7 4. Bf4 O-O 5. Nbd2 d5 6. h3 b6 7. e3 Bb7 8. a4 Nbd7 9. Be2 Ne4 10. a5 {Polugaevsky,Lev: '' Polugaevsky,Lev: '' Polugaevsky,Lev: '' Ftacnik: ''} Re8 11. O-O (11. a6 {Polugaevsky,Lev} Bc6 12. Nxe4 dxe4 13. d5 exf3 14. gxf3 e5 $13 15. Bg3 $13 {Ftacnik}) 11... e5 $2 (11... a6 $14 {Polugaevsky,Lev}) 12. dxe5 Nxe5 13. Bxe5 $1 {Polugaevsky,Lev: '!'} Bxe5 14. Bb5 $1 Bf6 {14. - e7 15.a6 + - , 14. - c6 15.a6 + -} (14... Re6 {Polugaevsky,Lev} 15. a6 Bc8 (15... Nxd2 {Ftacnik} 16. axb7 Nxf3+ 17. Qxf3 Rb8 18. Rxa7 $18) 16. Nxe4 $18) (14... Nxd2 {Polugaevsky,Lev} 15. Qxd2 Re6 16. a6 Bc8 17. c4 $5 $16 (17. Nxe5 Rxe5 18. Bc6 Rb8 19. Rfd1 Be6 20. c4 $16)) 15. Bxe8 Qxe8 16. axb6 axb6 17. Rxa8 Bxa8 18. Qc2 c5 19. Nxe4 (19. Ra1 $1 $18 {Polugaevsky,Lev Polugaevsky,Lev Polugaevsky,Lev Ftacnik: '!?'}) 19... dxe4 20. Nd2 Be5 21. Ra1 Bc6 22. Nc4 Bc7 23. Qd2 {Polugaevsky,Lev: '!' Polugaevsky,Lev: '!' Polugaevsky,Lev: '!' Ftacnik: '!'} b5 (23... Qe6 {Polugaevsky,Lev} 24. Ra7 $18) 24. Nd6 $6 Qe6 (24... Qe5 {Polugaevsky,Lev} 25. Rd1 b4 26. cxb4 Ba4 27. Qd5 $18) 25. Rd1 Kf8 (25... b4 {Polugaevsky,Lev} 26. cxb4 Ba4 27. bxc5 $18) 26. b4 {Polugaevsky,Lev: '!' Polugaevsky,Lev: '!' Polugaevsky,Lev: '!' Ftacnik: '!'} cxb4 (26... c4 {Polugaevsky,Lev} 27. Qd4 Ke7 28. Qa7 $18) 27. c4 (27. Qd4 $1 {Polugaevsky,Lev} Bxd6 28. Qxd6+ Qxd6 29. Rxd6 b3 30. Rd4 $1 $18) 27... Bxd6 (27... bxc4 {Polugaevsky,Lev} 28. Qxb4 $18) (27... b3 {Polugaevsky,Lev} 28. Nxb5 $18) 28. Qxd6+ Qxd6 29. Rxd6 b3 30. cxb5 Bxb5 31. Rb6 Bc4 32. Rb4 Bd5 33. Rd4 Bc6 (33... Be6 {Polugaevsky,Lev} 34. Rxe4 Ke7 35. Rd4 $18) 34. Kf1 h5 35. Ke1 Ke7 36. Kd2 Ke6 37. Kc3 (37. Rb4 $142 $1 {Polugaevsky,Lev Polugaevsky,Lev Polugaevsky,Lev Ftacnik: '!'} Bd5 38. Rb6+ Ke5 {Ftacnik} 39. Kc3 $18) 37... Bd5 38. h4 Ke5 (38... Kd6 {Polugaevsky,Lev} 39. Rb4 Kc5 40. Rb8 Be6 41. Rb7 $1 Bd5 42. Rb4 $18) 39. Rb4 Bc6 {Polugaevsky,Lev: '?!' Polugaevsky,Lev: '?!' Polugaevsky,Lev: '?!' Ftacnik: '?!'} (39... Kd6 {Polugaevsky,Lev} 40. Kd4 Kc6 41. Rb8 $1 Kc7 42. Rb5 Kc6 43. Rb4 Be6 44. f3 $1 (44. Kxe4 Kc5 $1 $13) 44... exf3 45. gxf3 f6 46. f4 { e4+-}) 40. Rxb3 {Polugaevsky,Lev: '+-'} Kf5 41. Kd4 Kg4 42. Rb6 Bd7 43. Rf6 Kxh4 (43... Be6 $2 {Polugaevsky,Lev} 44. Rf4# {#}) 44. Rxf7 Bf5 45. Ke5 Kg5 46. Rb7 h4 47. Rb4 Kg4 48. Rxe4+ Bxe4 49. Kxe4 g5 50. Ke5 Kh5 51. Kf5 1-0

