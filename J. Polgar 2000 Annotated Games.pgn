{[%evp 0,74,28,25,25,-2,33,32,58,58,58,37,70,54,34,28,30,25,33,20,26,0,-8,-55,-64,-107,-93,-145,-117,-109,-71,-176,-103,-100,-100,-40,-14,-248,-95,-190,-227,-227,-177,-289,-247,-333,-299,-336,-331,-300,-242,-310,-338,-338,-216,-302,-298,-268,-268,-580,-305,-468,-307,-411,-335,-424,-499,-579,-579,-676,-592,-592,-592,-637,-1009,-873,-1404]} 1. d4 Nf6 2. c4 c5 3. d5 b5 4. cxb5 a6 5. f3 e6 (5... axb5 $5 6. e4 Qa5+ 7. Bd2 b4) 6. e4 exd5 7. e5 Qe7 8. Qe2 Ng8 9. Nc3 Bb7 10. Nh3 c4 11. Nf4 Qc5 12. a4 $2 ({A principled line goes on with} 12. Nfxd5 $5 Bxd5 13. Be3 Qb4 14. a3 Qa5 15. Bd2 Be6 16. Nd5 {, when Black is staying in the game due to} c3 $1 17. Bxc3 Qd8 $13 {, see Chapter 5.}) 12... d4 13. bxa6 Nxa6 14. Ne4 Qb4+ (14... Qxe5 $19) 15. Kf2 d3 16. Qe3 Bc5 $2 (16... Bxe4 $1 17. Qxe4 Rc8 $19) 17. Nxc5 Nxc5 18. Nh5 $2 ({Missing the hidden resource} 18. Qd4 $1 Nb3 19. Nxd3 Qe7 20. Qxc4 Nxa1 21. Nc5 Rc8 22. b4 $44 {After the text the far advanced pawns will cost him dearly.}) 18... Ne7 (18... Nb3 $19) 19. Nxg7+ Kd8 20. Qe1 Qb6 ({Black prefers to preserve the opportunity to play for a mate and therefore the queens to the trivial} 20... Qxe1+ $5 21. Kxe1 Nb3 22. Rb1 Nxc1 23. Rxc1 Rxa4 $19) 21. Be3 Rg8 22. Nh5 Qxb2+ 23. Kg1 Qxe5 24. Ng3 f6 (24... d6) 25. f4 Qd5 26. Qb4 Ne4 27. Bb6+ Ke8 28. Re1 f5 29. a5 Kf7 30. Rc1 Rac8 31. Be3 h5 32. Nxh5 c3 33. Ng3 d2 34. Ra1 d1=Q 35. Rxd1 Qxd1 36. Qxb7 c2 37. Qb3+ d5 0-1

